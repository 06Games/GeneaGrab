{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeneaGrab",
  "version": "4.0.0",
  "identifier": "com.06games.geneagrab",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../frontend && bun run dev",
    "beforeBuildCommand": "cd ../frontend && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "GeneaGrab",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "publisher": "Evan Galli",
    "shortDescription": "A tool to download images of digitised registers",
    "longDescription": "GeneaGrab is a tool to download images of digitised registers available on the websites of various (mainly French) archive services.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["geneagrab"]
      }
    }
  }
}
